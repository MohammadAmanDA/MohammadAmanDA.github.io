---
import { getEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Link from '../components/Link.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex } = Astro.props;

const profile = (await getEntry('profile', 'profile'))!;
const { name, email, profiles } = profile.data;

// The site is one page. Nav entries are anchors into it, and resolve back to it
// from a project page.
// Each label is the section's own label, word for word. A nav that says
// "Work" over a section headed "Selected engagements" reads as two different
// sites; the descriptive line is the section headline's job, not the nav's.
const nav = [
  { href: '/#work', label: 'Selected work' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#research', label: 'Research' },
  { href: '/#contact', label: 'Contact' },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-IE">
  <head>
    <BaseHead title={title} description={description} noindex={noindex} />
    <script is:inline>
      // Render-blocking by necessity: prevents a flash of the wrong theme.
      try {
        const stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <div class="site-header__brand">
          <a class="site-header__name" href="/">{name}</a>
          <span class="chip site-header__chip">Forecasting &amp; Production ML</span>
        </div>

        <nav aria-label="Primary">
          <ul class="nav">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="site-header__actions">
          <ThemeToggle />
          <a class="btn btn--primary btn--sm" href={`mailto:${email}`}>
            Get in touch
            <svg
              class="btn__arrow"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4.5 11.5l7-7M6 4.5h5.5V10" />
            </svg>
          </a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    {/* A plain link, always present, no JavaScript. An earlier version revealed
        itself past 600px of scroll, but that depends on a scroll listener this
        environment does not dispatch, so it could not be verified. A control
        that is always there cannot fail to appear, and costs one small circle
        in the corner. */}
    <a href="#main" class="to-top" aria-label="Back to top">
      <span aria-hidden="true">↑</span>
    </a>

    {/* Scroll reveal, with a fallback that cannot leave content invisible.
        IntersectionObserver is the primary trigger. A slow poll runs alongside
        it and reveals anything that is already within the viewport, because an
        observer that silently fails to fire would otherwise leave sections at
        opacity 0 permanently. The poll stops once everything is revealed, or
        after 20 ticks. Skipped entirely under prefers-reduced-motion. */}
    <script is:inline>
      (() => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!('IntersectionObserver' in window)) return;
        document.documentElement.classList.add('js-reveal');

        const show = (el) => el.classList.add('is-in');
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              show(e.target);
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px' }
        );

        const start = () => {
          const all = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
          all.forEach((el) => io.observe(el));

          let ticks = 0;
          const sweep = () => {
            const left = all.filter((el) => !el.classList.contains('is-in'));
            left.forEach((el) => {
              const r = el.getBoundingClientRect();
              if (r.top < window.innerHeight && r.bottom > 0) show(el);
            });
            // Hard backstop. After six seconds anything still hidden is
            // revealed unconditionally, whatever the observer did or did not
            // do. The fade is a nice-to-have; the content is not.
            if (++ticks > 6) {
              left.forEach(show);
              clearInterval(timer);
              return;
            }
            if (!left.length) clearInterval(timer);
          };
          const timer = setInterval(sweep, 1000);
          sweep();
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', start);
        } else {
          start();
        }
      })();
    </script>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <p class="meta-xs">© {year} {name} · Dublin, Ireland</p>
        <ul class="site-footer__links meta-xs">
          <li><a href={`mailto:${email}`}>{email}</a></li>
          {
            profiles.map((p) => (
              <li>
                <Link href={p.href}>{p.label}</Link>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Sticky, so the bar stays available the way the reference's does. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background-color: var(--color-bg);
    border-bottom: var(--border-hairline);
    padding-block: var(--space-3);
  }

  /* Three groups spread across the bar: brand left, nav centred, actions
     right. space-between across three children puts the nav in the middle. */
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .site-header__name {
    font-size: var(--scale-sm);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__chip {
    display: none;
  }

  @media (min-width: 72rem) {
    .site-header__chip {
      display: inline-block;
    }
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Same face, size, weight and tracking as .section__label, so the nav and
     the heading it points at are visibly the same thing. It used to be the
     sans at 0.12em, which rendered a shade larger and wider than the mono
     labels below it. */
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--scale-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .nav a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  main {
    padding-block: var(--space-12) var(--space-24);
  }

  .to-top {
    position: fixed;
    right: var(--space-6);
    bottom: var(--space-6);
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: var(--border-width) solid var(--color-border);
    border-radius: 50%;
    background-color: var(--color-surface);
    color: var(--color-text-muted);
    text-decoration: none;
    font-family: var(--font-ui);
    font-size: var(--scale-sm);
    line-height: 1;
  }

  .to-top:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .site-footer {
    border-top: var(--border-width) solid var(--color-rule);
    padding-block: var(--space-8);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
  }

  @media (max-width: 56rem) {
    .site-header__inner {
      flex-wrap: wrap;
    }
    .site-header nav {
      order: 3;
      width: 100%;
    }
    .site-header__actions {
      margin-left: auto;
    }
  }
</style>
