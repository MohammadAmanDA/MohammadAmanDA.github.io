---
import { getEntry } from 'astro:content';

interface Props {
  title: string;
  description: string;
  /** Set on the one page that should not be indexed, if any. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

const profile = await getEntry('profile', 'profile');
const name = profile?.data.name ?? '';

const canonical = new URL(Astro.url.pathname, Astro.site);
// TK: no OG image yet, Q-D5. A missing og:image is better than a broken one,
// so the tag is omitted rather than pointed at a file that does not exist.
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{/* Without this the browser asks for /favicon.ico on every page load and
    gets a 404, which is a console error on a site whose acceptance criteria
    say there are none. One file, no request beyond the icon itself. */}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={name} />

<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

{/* The three faces used above the fold on every page: the display serif, the
    body sans and the label mono. Each matches an
    @font-face in global.css, so nothing here downloads a font the CSS never asks for. */}
<link
  rel="preload"
  href="/fonts/instrument-serif-latin-400-normal.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link rel="preload" href="/fonts/plus-jakarta-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
<link
  rel="preload"
  href="/fonts/jetbrains-mono-latin-wght-normal.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

<link rel="sitemap" href="/sitemap-index.xml" />
