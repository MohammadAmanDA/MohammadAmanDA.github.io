---
/**
 * The only interactive element in Phase 2, and the only JS on the site so far.
 *
 * The <head> script below is render-blocking by design: it reads the stored
 * preference and stamps `data-theme` before first paint, so there is no flash
 * of the wrong theme. It is inlined because an external request would defeat
 * the purpose. This is the sole exception to the zero-JS default.
 */
---

<button
  type="button"
  id="theme-toggle"
  class="theme-toggle"
  aria-pressed="false"
  data-label-dark="Switch to dark theme"
  data-label-light="Switch to light theme"
>
  <span aria-hidden="true" class="theme-toggle__icon">◐</span>
  <span class="visually-hidden" id="theme-toggle-label">Switch theme</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: var(--space-2);
    background-color: transparent;
    color: var(--color-text-muted);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    cursor: pointer;
    font-size: var(--scale-base);
    font-family: inherit;
  }

  .theme-toggle:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }
</style>

<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const label = document.getElementById('theme-toggle-label');

    const resolved = () =>
      document.documentElement.dataset.theme ??
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

    const sync = () => {
      const isDark = resolved() === 'dark';
      btn.setAttribute('aria-pressed', String(isDark));
      const next = isDark ? btn.dataset.labelLight : btn.dataset.labelDark;
      if (label && next) label.textContent = next;
    };

    btn.addEventListener('click', () => {
      const next = resolved() === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* private mode: the toggle still works for this page view */
      }
      sync();
    });

    sync();
  })();
</script>
