---
/**
 * Liquid glass navbar.
 *
 * A port of Nimbus UI's "Waterline" navbar by guglielmogiannattasio.it,
 * published on 21st.dev. The original is a React component for a Tailwind and
 * shadcn project. This site has none of those: it is Astro with plain CSS and
 * ships no framework, so the component is rewritten as one Astro file with an
 * inline script. The behaviour that makes it worth having is kept:
 *
 *   - a glass pill, with a drop of water that stretches toward the item you
 *     pick, breaks into droplets on a long jump and merges back with a ripple
 *   - a meniscus that follows the cursor across the pill
 *   - a ripple on every press
 *   - a WebGL shader for the water, paused when the bar is off-screen or the
 *     tab is hidden, falling back to a plain CSS drop where WebGL is missing
 *
 * Three deliberate departures from the original:
 *
 *   1. No icons and none of the per-icon animations. The original plays a
 *      little scene per item, a paper plane flying off, a drop splashing. They
 *      belong to a travel app. A globe spinning next to "Research" on a
 *      consultant's site reads as decoration for its own sake, so the items
 *      are text only.
 *   2. Every colour is read from the stylesheet at runtime and passed to the
 *      shader as a uniform, rather than being written into the shader. The
 *      original's water is blue; this one is the palette's amber, and it
 *      re-tints when the theme changes. It also keeps the file free of
 *      hardcoded colour, which `npm run check:tokens` enforces.
 *   3. The items are real anchors to real sections. The water follows the
 *      cursor while you are over the bar, and the rest of the time it sits
 *      under whatever section you are actually reading, not only under what
 *      you last clicked.
 *
 * The bar carries the whole header, not only the links: a "start" slot for
 * the brand and an "end" slot for the controls, with the links between them.
 * The glass is the bar itself, so the name sits on the same pane as the nav
 * rather than on bare paper beside a floating pill.
 */
interface Props {
  items: { href: string; label: string }[];
  label?: string;
}

const { items, label = 'Primary' } = Astro.props;

// Canvas bleed around the pill, so shadows and ripples are not clipped. Must
// match PAD in the script below.
const PAD = 14;
---

<div class="lq" data-lq data-gl="on">
  <span class="lq__glass" aria-hidden="true"></span>
  <canvas class="lq__water" data-lq-canvas aria-hidden="true" style={`left:${-PAD}px;top:${-PAD}px`}
  ></canvas>
  <span class="lq__drop" data-lq-drop aria-hidden="true"></span>

  <div class="lq__start"><slot name="start" /></div>

  <nav class="lq__nav" aria-label={label}>
    {
      items.map((item) => (
        <a class="lq__item" href={item.href} data-lq-item data-href={item.href}>
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="lq__end"><slot name="end" /></div>
</div>

<style>
  /* The bar. Carries the brand, the links and the controls on one pane.
     position:relative because the script measures each item with offsetLeft
     and offsetTop, which are relative to the offset parent, and because the
     glass and the canvas are absolutely positioned against it. */
  .lq {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    width: 100%;
    padding: 6px;
    border-radius: 999px;
    isolation: isolate;
    -webkit-tap-highlight-color: transparent;
  }

  /* The three groups, lifted above the glass and the water, which sit at
     negative z-index inside the bar's stacking context.

     Deliberately not position:relative. A flex item takes z-index without
     being positioned, and making these positioned would make them the offset
     parent of the links, which the script measures. */
  .lq__start,
  .lq__nav,
  .lq__end {
    z-index: 1;
    display: flex;
    align-items: center;
  }

  /* Neither side group may be squeezed. Everything in them sets
     white-space:nowrap, so shrinking does not reflow the text, it spills it
     over the links instead. The bar wraps to another row rather than letting
     that happen. */
  .lq__start,
  .lq__end {
    flex: none;
  }

  .lq__start {
    gap: var(--space-3);
    padding-left: var(--space-4);
  }

  /* Only the links suppress selection. Dragging across the name should still
     select it. */
  .lq__nav {
    gap: 2px;
    user-select: none;
  }

  .lq__end {
    gap: var(--space-3);
  }

  /* The glass itself. Sits behind everything on the bar and behind the water,
     blurring whatever is scrolling underneath. The fill is the page's own
     colour at a measured opacity, not a white wash: see --lq-pane. */
  .lq__glass {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    border-radius: inherit;
    background: var(--lq-pane);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
    box-shadow:
      inset 0 1px 1px var(--lq-rim),
      inset 0 0 0 1px var(--lq-glass),
      var(--lq-shadow);
  }

  .lq__water {
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }

  .lq[data-gl='off'] .lq__water {
    display: none;
  }

  /* The fallback drop, shown only when WebGL is unavailable or the context is
     lost. A plain rounded rectangle that slides and squashes. */
  .lq__drop {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    height: 0;
    z-index: -1;
    border-radius: 999px;
    pointer-events: none;
    background: var(--lq-water);
    box-shadow:
      inset 0 1px 1px var(--lq-rim),
      inset 0 0 0 1px var(--lq-glass);
    will-change: transform, width;
  }

  .lq[data-gl='off'] .lq__drop {
    display: block;
  }

  /* The items. Same face, size, weight and tracking as .section__label, so the
     nav and the heading it points at are visibly the same thing. */
  .lq__item {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    height: 34px;
    padding: 0 14px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--scale-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--color-text-muted);
    transition: color var(--duration-base) var(--ease-out);
  }

  .lq__item:hover,
  .lq__item[aria-current='page'] {
    color: var(--color-text);
  }

  /* The active item also gains weight, so the state is never carried by colour
     alone. */
  .lq__item[aria-current='page'] {
    font-weight: 700;
  }

  .lq__item:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* Narrow screens: the bar wraps to two rows, brand and controls above, the
     links below. A stadium radius on a two-row bar reads as a lozenge, so the
     corner is fixed instead; the script reads the computed radius and gives
     the shader the same number, so the water's edge follows the glass. */
  @media (max-width: 56rem) {
    .lq {
      flex-wrap: wrap;
      row-gap: var(--space-2);
      padding: var(--space-3);
      border-radius: 26px;
    }

    .lq__start {
      padding-left: var(--space-2);
    }

    .lq__nav {
      order: 3;
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
    }

    /* On the narrowest screens the brand takes a row to itself and the
       controls drop to the next one, where space-between has nothing to
       space and would leave them hanging on the left. */
    .lq__end {
      margin-left: auto;
    }
  }

  @media (max-width: 40rem) {
    .lq {
      padding: var(--space-2);
      row-gap: 2px;
    }

    .lq__start {
      padding-left: var(--space-2);
    }

    .lq__item {
      height: 30px;
      padding: 0 10px;
      letter-spacing: 0.06em;
    }
  }

  /* Reduced motion. The water stops moving entirely: the shader draws one
     still frame per selection and the drop does not travel, squash, split or
     ripple. The pill, the glass and the active state all remain. */
  @media (prefers-reduced-motion: reduce) {
    .lq__item {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const PAD = 14;

    /* Reads a token and returns it as three 0..1 floats for the shader. Custom
       properties come back as authored, so these are the hex strings written
       in global.css and no colour literal is needed here. */
    const readTint = (cs, name, fallback) => {
      const v = (cs.getPropertyValue(name) || '').trim();
      if (v.charAt(0) !== '#' || (v.length !== 7 && v.length !== 4)) return fallback;
      const h = v.length === 4 ? v[1] + v[1] + v[2] + v[2] + v[3] + v[3] : v.slice(1);
      return [
        parseInt(h.slice(0, 2), 16) / 255,
        parseInt(h.slice(2, 4), 16) / 255,
        parseInt(h.slice(4, 6), 16) / 255,
      ];
    };

    const VERT = 'attribute vec2 a;void main(){gl_Position=vec4(a,0.,1.);}';

    /* The water. Signed distance fields for the pill and for the drop, a
       height field built from both plus the ripples and the cursor, and a
       normal taken from that height for the specular and refraction. Lifted
       from the original with the colour constants replaced by uTint and uLens,
       and the iridescence kept because it is what makes it read as water
       rather than as a coloured blob. */
    const FRAG = [
      'precision highp float;',
      'uniform vec2 uRes;uniform float uDpr;uniform float uTime;uniform vec4 uPill;',
      'uniform vec4 uBlob[6];uniform float uSy[6];uniform vec4 uRip[6];',
      'uniform vec3 uMouse;uniform float uDark;uniform float uAmb;uniform float uR;',
      'uniform vec3 uTint;uniform vec3 uLens;',
      'float sdRB(vec2 p,vec2 b,float r){vec2 q=abs(p)-b+r;return length(max(q,0.))+min(max(q.x,q.y),0.)-r;}',
      'float sdCap(vec2 p,vec4 B,float sy){p-=B.xy;p.y/=sy;p.x=max(abs(p.x)-B.z,0.);return(length(p)-B.w)*min(1.,sy);}',
      'float smin(float a,float b,float k){float h=clamp(.5+.5*(b-a)/k,0.,1.);return mix(b,a,h)-k*h*(1.-h);}',
      'float dropD(vec2 p){float d=1e4;for(int i=0;i<6;i++){if(uBlob[i].w>.5){d=smin(d,sdCap(p,uBlob[i],uSy[i]),13.);}}return d;}',
      'float pillD(vec2 p){vec2 h=uPill.zw*.5;return sdRB(p-uPill.xy-h,h,min(uR,min(h.x,h.y)));}',
      'float lens(float d,float w){float t=clamp(-d/w,0.,1.);return sqrt(1.-(1.-t)*(1.-t));}',
      'float waves(vec2 p){float w=0.;',
      ' for(int i=0;i<6;i++){vec4 R=uRip[i];if(R.w>0.){float x=length(p-R.xy)-R.z*240.;w+=R.w*exp(-R.z*1.7)*sin(x*.3)*exp(-x*x/700.);}}',
      ' vec2 m=p-uMouse.xy;w+=uMouse.z*3.6*exp(-dot(m,m)/1000.);',
      ' w+=uAmb*(sin(p.x*.05+uTime*1.2)*.45+sin(p.x*.13-uTime*.85+p.y*.2)*.25);return w;}',
      'float H(vec2 p){float dp=pillD(p);return lens(dp,uPill.w*.36)*2.4+lens(dropD(p),11.)*7.5+waves(p)*smoothstep(0.,7.,-dp);}',
      'float caus(vec2 p,float t){vec2 q=p;float c=0.;for(int i=0;i<3;i++){q+=vec2(sin(q.y*1.1+t),cos(q.x*1.3-t*.7))*.6;c+=1./(1.+16.*abs(sin(q.x)*sin(q.y)));}return c/3.;}',
      'void main(){',
      ' vec2 p=vec2(gl_FragCoord.x,uRes.y*uDpr-gl_FragCoord.y)/uDpr;',
      ' float dp=pillD(p);float dd=dropD(p);',
      ' float h0=H(p);vec3 n=normalize(vec3(h0-H(p+vec2(1.,0.)),h0-H(p+vec2(0.,1.)),1.));',
      ' vec3 V=vec3(0.,0.,1.);',
      ' float spec=pow(max(dot(reflect(-normalize(vec3(-.45,-.8,.85)),n),V),0.),70.);',
      ' float spec2=pow(max(dot(reflect(-normalize(vec3(.6,.75,.7)),n),V),0.),22.)*.3;',
      ' float fres=clamp((1.-n.z)*4.,0.,1.);',
      ' vec3 irid=.5+.5*cos(6.2831*(vec3(0.,.33,.67)+fres*.85+p.x*.0028+uTime*.035));',
      ' float pm=smoothstep(1.,-1.,dp);float dm=smoothstep(1.,-1.,dd)*smoothstep(1.,-2.,dp);',
      ' float sh=smoothstep(9.,-9.,dropD(p-vec2(0.,5.)))*(1.-dm)*pm*(.11+.07*uDark);',
      ' vec3 c=uLens*.35*sh;float a=sh;',
      ' float pa=clamp(pm*(fres*.5+spec*.9+spec2),0.,1.);',
      ' c=mix(vec3(1.),irid,.4*fres)*pa+c*(1.-pa);a=pa+a*(1.-pa);',
      ' float th=lens(dd,11.);',
      ' float cs=caus((p+n.xy*th*18.)*.085,uTime*.9);',
      ' float rim=dm*(1.-smoothstep(0.,8.,-dd));',
      ' float cres=dm*smoothstep(.12,.55,dot(n.xy,normalize(vec2(.55,.85))))*smoothstep(0.,3.,-dd);',
      ' float body=.5+.5*clamp(-n.y*3.,-1.,1.);',
      ' float da=dm*(.3+.16*body)*(1.-.2*uDark);vec3 dc=mix(uTint,vec3(1.),body*.5);',
      ' float la=rim*.26;dc=uLens*la+dc*da*(1.-la);da=la+da*(1.-la);',
      ' la=clamp(cres*.7+smoothstep(.6,1.,cs)*.28*th*dm,0.,1.);dc=vec3(1.)*la+dc*(1.-la);da=la+da*(1.-la);',
      ' la=clamp(dm*(spec*1.2+spec2*.5),0.,1.);dc=vec3(1.)*la+dc*(1.-la);da=la+da*(1.-la);',
      ' la=dm*smoothstep(-2.,0.,dd)*.35;dc=mix(vec3(1.),irid,.3)*la+dc*(1.-la);da=la+da*(1.-la);',
      ' c=dc+c*(1.-da);a=da+a*(1.-da);',
      ' gl_FragColor=vec4(c,a);',
      '}',
    ].join('\n');

    const initGL = (canvas) => {
      let gl = null;
      try {
        gl = canvas.getContext('webgl', {
          premultipliedAlpha: true,
          alpha: true,
          antialias: false,
        });
      } catch (e) {
        return null;
      }
      if (!gl) return null;
      const sh = (type, src) => {
        const s = gl.createShader(type);
        gl.shaderSource(s, src);
        gl.compileShader(s);
        return gl.getShaderParameter(s, gl.COMPILE_STATUS) ? s : null;
      };
      const vs = sh(gl.VERTEX_SHADER, VERT);
      const fs = sh(gl.FRAGMENT_SHADER, FRAG);
      if (!vs || !fs) return null;
      const prog = gl.createProgram();
      gl.attachShader(prog, vs);
      gl.attachShader(prog, fs);
      gl.linkProgram(prog);
      if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return null;
      gl.useProgram(prog);
      const buf = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'a');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
      const u = {};
      [
        'uRes',
        'uDpr',
        'uTime',
        'uPill',
        'uBlob',
        'uSy',
        'uRip',
        'uMouse',
        'uDark',
        'uAmb',
        'uTint',
        'uLens',
        'uR',
      ].forEach((n) => {
        u[n] = gl.getUniformLocation(prog, n);
      });
      gl.enable(gl.BLEND);
      gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
      return { gl: gl, u: u };
    };

    const initNav = (root) => {
      const canvas = root.querySelector('[data-lq-canvas]');
      const dropEl = root.querySelector('[data-lq-drop]');
      const items = Array.prototype.slice.call(root.querySelectorAll('[data-lq-item]'));
      if (!items.length) return;

      const reduceQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

      const s = {
        a: { x: 0, v: 0 },
        b: { x: 0, v: 0 },
        sy: { s: 1, v: 0 },
        lead: 0,
        lagFrom: 0,
        sats: [],
        rips: [],
        t: { x: 0, cy: 0, q: 0, r: 17 },
        q: 0,
        mouse: { x: 0, y: 0, s: 0, on: false },
        moving: false,
        split: false,
        ready: false,
        w: 0,
        h: 0,
        radius: 999,
        visible: true,
        reduce: reduceQuery.matches,
        raf: 0,
        last: 0,
        time: 0,
        tint: [1, 0.92, 0.86],
        lens: [0.79, 0.39, 0.26],
        dark: 0,
        glc: null,
      };

      /* Three different answers to "which item is the water under", and the
         one that wins.

         `active` is the section you are reading, or the one you last clicked,
         and it is the only one that carries aria-current. `hoverIdx` and
         `focusIdx` are previews: pointing at an item sends the water there
         without claiming you have navigated, and it comes back when you
         leave. `shown` is whichever of the three is driving the water right
         now, and is the only one measure() reads. */
      let active = 0;
      let shown = 0;
      let hoverIdx = -1;
      let focusIdx = -1;

      /* Tints come from the stylesheet, so the water follows the theme. Called
         again whenever the theme changes. */
      const readTheme = () => {
        const cs = getComputedStyle(document.documentElement);
        s.tint = readTint(cs, '--lq-water', s.tint);
        s.lens = readTint(cs, '--lq-lens', s.lens);
        // Luminance of the page colour decides whether the shader treats the
        // scene as dark, which only affects the shadow and the body opacity.
        const bg = readTint(cs, '--color-bg', [1, 1, 1]);
        s.dark = 0.2126 * bg[0] + 0.7152 * bg[1] + 0.0722 * bg[2] < 0.5 ? 1 : 0;
      };

      /* Keeps the drawing buffer in step with the CSS size and the current
         device pixel ratio. Checked every frame rather than only on resize,
         because the ratio can change without the element changing size at
         all: dragging the window to a monitor with a different scale factor,
         or zooming the page. When that happened the buffer stayed at the old
         scale while the shader was told the new one, and the water was drawn
         at the wrong size and about forty pixels above the pill. Returns the
         ratio it used, so the caller passes the shader the same number the
         buffer was built with. */
      const sizeCanvas = () => {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        if (!canvas) return dpr;
        const W = Math.round((s.w + PAD * 2) * dpr);
        const H = Math.round((s.h + PAD * 2) * dpr);
        if (canvas.width !== W || canvas.height !== H) {
          canvas.width = W;
          canvas.height = H;
          canvas.style.width = s.w + PAD * 2 + 'px';
          canvas.style.height = s.h + PAD * 2 + 'px';
        }
        return dpr;
      };

      const draw = () => {
        const T = s.t;
        const sep = Math.abs(s.a.x - s.b.x);
        const thin = Math.min(sep / (2 * (s.q + T.r) || 1), 1);
        const r = T.r * (1 - 0.3 * thin);
        if (s.glc) {
          const g = s.glc.gl;
          const u = s.glc.u;
          const dpr = sizeCanvas();
          g.viewport(0, 0, g.drawingBufferWidth, g.drawingBufferHeight);
          g.uniform2f(u.uRes, s.w + PAD * 2, s.h + PAD * 2);
          g.uniform1f(u.uDpr, dpr);
          g.uniform1f(u.uTime, s.time);
          g.uniform4f(u.uPill, PAD, PAD, s.w, s.h);
          g.uniform1f(u.uR, s.radius);
          const blobs = new Float32Array(24);
          const sy = new Float32Array(6);
          for (let i = 0; i < 6; i++) sy[i] = 1;
          const head = s.lead === 0 ? s.a : s.b;
          const tail = s.lead === 0 ? s.b : s.a;
          blobs.set(
            [
              head.x,
              T.cy,
              s.q * (1 - 0.25 * thin),
              T.r * (1 - 0.12 * thin),
              tail.x,
              T.cy,
              s.q * (1 - 0.8 * thin),
              T.r * (1 - 0.5 * thin),
            ],
            0
          );
          sy[0] = s.sy.s;
          sy[1] = s.sy.s;
          s.sats.slice(0, 4).forEach((d, i) => blobs.set([d.x, d.y, 0, d.r], 8 + i * 4));
          g.uniform4fv(u.uBlob, blobs);
          g.uniform1fv(u.uSy, sy);
          const rips = new Float32Array(24);
          s.rips.slice(-6).forEach((p, i) => rips.set([p.x, p.y, p.age, p.amp], i * 4));
          g.uniform4fv(u.uRip, rips);
          g.uniform3f(u.uMouse, s.mouse.x, s.mouse.y, s.mouse.s);
          g.uniform1f(u.uDark, s.dark);
          g.uniform1f(u.uAmb, s.reduce ? 0 : 1);
          g.uniform3fv(u.uTint, s.tint);
          g.uniform3fv(u.uLens, s.lens);
          g.clearColor(0, 0, 0, 0);
          g.clear(g.COLOR_BUFFER_BIT);
          g.drawArrays(g.TRIANGLES, 0, 3);
        } else if (dropEl) {
          const left = Math.min(s.a.x, s.b.x) - s.q - r - PAD;
          const width = sep + 2 * (s.q + r);
          // The drop element is positioned against the bar, which has no PAD,
          // while the target's geometry is in canvas space, which does. The
          // row matters now that the bar is taller than one item and wraps to
          // two rows on a phone.
          dropEl.style.top = T.cy - PAD - T.r + 'px';
          dropEl.style.height = 2 * T.r + 'px';
          dropEl.style.width = width + 'px';
          dropEl.style.transform = 'translateX(' + left + 'px) scaleY(' + s.sy.s + ')';
        }
      };

      const step = (dt, now) => {
        const T = s.t;
        s.time += dt;
        s.q += (T.q - s.q) * Math.min(1, dt * 12);
        let still = true;
        if (s.reduce) {
          s.a.x = T.x;
          s.b.x = T.x;
          s.a.v = 0;
          s.b.v = 0;
          s.sy.s = 1;
          s.sats = [];
        } else {
          const bodies = [s.a, s.b];
          bodies.forEach((B, i) => {
            const isLead = i === s.lead;
            const k = isLead ? 210 : 72;
            const c = isLead ? 25 : 13;
            const f = !isLead && now < s.lagFrom ? 0.08 : 1;
            B.v += (k * (T.x - B.x) - c * B.v) * dt * f;
            B.x += B.v * dt;
            const lo = PAD + 5 + s.q + T.r - 3;
            const hi = PAD + s.w - 5 - s.q - T.r + 3;
            if (B.x < lo || B.x > hi) {
              s.sy.v -= Math.min(Math.abs(B.v), 900) * 0.0016;
              B.x = Math.max(lo, Math.min(hi, B.x));
              B.v *= -0.25;
            }
            if (Math.abs(T.x - B.x) > 0.3 || Math.abs(B.v) > 3) still = false;
          });
          const L = bodies[s.lead];
          const syT = 1 - 0.2 * Math.min(Math.abs(L.v) / 1500, 1);
          s.sy.v += (280 * (syT - s.sy.s) - 9 * s.sy.v) * dt;
          s.sy.s += s.sy.v * dt;
          if (Math.abs(s.sy.s - 1) > 0.002 || Math.abs(s.sy.v) > 0.02) still = false;

          // Break the neck: once head and tail are far enough apart that the
          // body between them would be a thread, spawn droplets.
          const sep = Math.abs(s.a.x - s.b.x);
          const rr = T.r * (1 - 0.3 * Math.min(sep / (2 * (T.q + T.r) || 1), 1));
          if (!s.split && s.moving && sep - 2 * T.q - 2 * rr > -6) {
            s.split = true;
            const lo = bodies[1 - s.lead];
            const hi = bodies[s.lead];
            [0.3, 0.5, 0.72].forEach((t, j) => {
              s.sats.push({
                x: lo.x + (hi.x - lo.x) * t + (Math.random() - 0.5) * 6,
                y: T.cy + (Math.random() - 0.5) * 8,
                vx: (lo.v + hi.v) * 0.45,
                vy: (Math.random() - 0.5) * 60,
                r: 4 + Math.random() * 2.5 - j * 0.4,
                k: 70 + Math.random() * 90,
              });
            });
          }
          s.sats = s.sats.filter((d) => {
            d.vx += (d.k * (T.x - d.x) - 9 * d.vx) * dt;
            d.vy += (90 * (T.cy - d.y) - 7 * d.vy) * dt;
            d.x += d.vx * dt;
            d.y += d.vy * dt;
            d.x = Math.max(PAD + 8 + d.r, Math.min(PAD + s.w - 8 - d.r, d.x));
            d.y = Math.max(T.cy - T.r + d.r, Math.min(T.cy + T.r - d.r, d.y));
            if (Math.abs(T.x - d.x) < T.q + T.r * 0.5) d.r -= dt * 26;
            return d.r > 0.6;
          });
          if (s.sats.length) still = false;
        }
        if (s.moving && still) {
          s.moving = false;
          if (!s.reduce) s.rips.push({ x: T.x, y: T.cy, age: 0, amp: s.split ? 1.2 : 0.7 });
        }
        s.rips.forEach((p) => {
          p.age += dt;
        });
        s.rips = s.rips.filter((p) => p.age < 2.4);
        s.mouse.s += ((s.mouse.on ? 1 : 0) - s.mouse.s) * Math.min(1, dt * 7);
      };

      const loop = () => {
        if (s.raf) return;
        s.last = performance.now();
        const tick = (now) => {
          const dt = Math.min((now - s.last) / 1000, 1 / 30);
          s.last = now;
          step(dt, now);
          draw();
          const busy = s.moving || s.rips.length || s.sats.length || s.mouse.s > 0.01;
          // Ambient motion continues while the bar is on screen. Under reduced
          // motion the loop runs only long enough to settle a change, then
          // stops, so nothing moves on its own.
          if (s.visible && (!s.reduce || busy)) s.raf = requestAnimationFrame(tick);
          else s.raf = 0;
        };
        s.raf = requestAnimationFrame(tick);
      };

      const measure = () => {
        const el = items[shown];
        if (!el) return;
        /* Geometry from rects rather than offsetLeft/offsetTop. The links are
           now nested one level down, inside the nav group, so offsetTop and
           offsetLeft depend on which ancestor happens to be positioned.
           Measuring both boxes and subtracting gives the same numbers without
           caring about the structure between them. */
        const rb = root.getBoundingClientRect();
        const ri = el.getBoundingClientRect();
        s.w = rb.width;
        s.h = rb.height;
        // The shader draws its own rounded rectangle, so it has to be told
        // the corner the stylesheet chose. Reading it keeps the two in step
        // when the bar wraps to two rows and the radius stops being half the
        // height.
        const rr = parseFloat(getComputedStyle(root).borderTopLeftRadius);
        s.radius = rr > 0 ? Math.min(rr, s.h / 2, s.w / 2) : s.h / 2;
        const T = s.t;
        T.r = ri.height / 2;
        T.q = Math.max(0, ri.width / 2 - T.r);
        T.cy = PAD + (ri.top - rb.top) + ri.height / 2;
        const nx = PAD + (ri.left - rb.left) + ri.width / 2;
        if (!s.ready) {
          s.a.x = nx;
          s.b.x = nx;
          s.q = T.q;
          s.ready = true;
        } else if (Math.abs(nx - T.x) > 0.5) {
          s.lead = Math.abs(nx - s.a.x) <= Math.abs(nx - s.b.x) ? 0 : 1;
          s.lagFrom = performance.now() + 70;
          s.moving = true;
          s.split = false;
        }
        T.x = nx;
        sizeCanvas();
        loop();
      };

      /* Hover beats focus, focus beats the active section. Re-measures only
         when the winner actually changes, or on the very first call, so the
         scroll spy's 150ms tick costs nothing while the answer is steady. */
      const resolve = () => {
        const next = hoverIdx >= 0 ? hoverIdx : focusIdx >= 0 ? focusIdx : active;
        if (next === shown && s.ready) return;
        shown = next;
        measure();
      };

      const setActive = (i) => {
        if (i < 0 || i >= items.length) return;
        active = i;
        items.forEach((el, j) => {
          if (j === i) el.setAttribute('aria-current', 'page');
          else el.removeAttribute('aria-current');
        });
        resolve();
      };

      const local = (clientX, clientY) => {
        const r = root.getBoundingClientRect();
        return { x: clientX - r.left + PAD, y: clientY - r.top + PAD };
      };

      const ripple = (x, y, amp) => {
        if (s.reduce) return;
        s.rips.push({ x: x, y: y, age: 0, amp: amp });
        loop();
      };

      // ---- wiring ----

      readTheme();
      s.glc = canvas ? initGL(canvas) : null;
      if (!s.glc) root.dataset.gl = 'off';

      if (canvas) {
        canvas.addEventListener('webglcontextlost', (e) => {
          e.preventDefault();
          s.glc = null;
          root.dataset.gl = 'off';
        });
      }

      // The active item starts as whichever one matches the current URL.
      const hash = window.location.hash;
      if (hash) {
        let found = -1;
        items.forEach((el, i) => {
          if (found < 0 && (el.dataset.href || '').slice(-hash.length) === hash) found = i;
        });
        if (found >= 0) active = found;
      }
      setActive(active);

      items.forEach((el, i) => {
        el.addEventListener('click', () => {
          const box = el.getBoundingClientRect();
          const p = local(box.left + box.width / 2, box.top + box.height / 2);
          ripple(p.x, p.y, 0.9);
          setActive(i);
        });

        /* Pointing at an item sends the water to it. Handled by the bar's own
           pointermove below rather than by pointerenter here, so that moving
           off an item onto the brand or the buttons returns the water to the
           active section instead of stranding it under the last link.

           The keyboard gets the same treatment, so tabbing through the bar
           moves the water the way the cursor does. focus rather than
           focusin: these are leaf anchors with nothing focusable inside. */
        el.addEventListener('focus', () => {
          focusIdx = i;
          resolve();
        });

        el.addEventListener('blur', () => {
          if (focusIdx === i) focusIdx = -1;
          resolve();
        });
      });

      root.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        const p = local(e.clientX, e.clientY);
        s.mouse.x = p.x;
        s.mouse.y = p.y;
        s.mouse.on = true;
        // Which item, if any, is under the cursor. Hit-testing the real
        // target rather than tracking enter and leave per item means the
        // answer is recomputed from scratch on every move and cannot get
        // stuck, and the gaps between items are only 2px, so the water does
        // not visibly fall back while crossing one.
        const over = e.target && e.target.closest ? e.target.closest('[data-lq-item]') : null;
        const idx = over ? items.indexOf(over) : -1;
        if (idx !== hoverIdx) {
          hoverIdx = idx;
          resolve();
        }
        loop();
      });

      root.addEventListener('pointerleave', () => {
        s.mouse.on = false;
        hoverIdx = -1;
        resolve();
        loop();
      });

      root.addEventListener('pointerdown', (e) => {
        const p = local(e.clientX, e.clientY);
        ripple(p.x, p.y, 0.8);
      });

      // Pause when off screen or when the tab is hidden, so an idle page is
      // not animating a shader nobody can see.
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          s.visible = entries[0].isIntersecting;
          if (s.visible) loop();
        });
        io.observe(root);

      }

      /* Scroll spy. The water follows what you are reading, not only what you
         last clicked. Only sections that exist on this page are watched, so
         the project pages, whose nav links point back to the home page, simply
         keep the clicked state.

         Driven by a slow poll rather than by a scroll listener or an
         IntersectionObserver. Both were tried. A band observer has a hole at
         the end of the document, where the last section comes to rest below
         the band and never enters it, and both the scroll event and the
         observer callback proved unreliable to verify. A poll that reads the
         live geometry answers the question directly: which section's top has
         most recently passed under the header. Four getBoundingClientRect
         reads every 150ms is not a measurable cost, and nothing can wedge it
         into a wrong state, because it recomputes the answer from scratch
         rather than accumulating transitions. */
      const targets = [];
      items.forEach((el, i) => {
        const href = el.dataset.href || '';
        const cut = href.indexOf('#');
        const section = cut >= 0 ? document.getElementById(href.slice(cut + 1)) : null;
        if (section) targets.push({ i: i, el: section });
      });

      if (targets.length > 1) {
        const spy = () => {
          if (document.visibilityState !== 'visible') return;
          const doc = document.documentElement;
          // At the very bottom the last section is what you are reading, even
          // though its top never climbs as far as the header.
          const atBottom = Math.ceil(window.scrollY + window.innerHeight) >= doc.scrollHeight - 2;
          let hit = atBottom ? targets[targets.length - 1].i : -1;
          if (!atBottom) {
            const line = root.getBoundingClientRect().bottom + 24;
            targets.forEach((t) => {
              if (t.el.getBoundingClientRect().top <= line) hit = t.i;
            });
            // Above the first section, the first item leads.
            if (hit < 0) hit = targets[0].i;
          }
          if (hit !== active) setActive(hit);
        };
        // Not called eagerly: at DOMContentLoaded the sections have not had
        // their final heights yet, and a reading taken then can report every
        // section as already passed, which lands on the last one. The first
        // tick arrives 150ms later against settled layout.
        setInterval(spy, 150);
      }

      if ('ResizeObserver' in window) {
        let lastW = -1;
        const ro = new ResizeObserver(() => {
          const w = root.offsetWidth;
          if (w === lastW) return;
          lastW = w;
          s.ready = false;
          measure();
        });
        ro.observe(root);
      } else {
        window.addEventListener('resize', measure);
      }

      document.addEventListener('visibilitychange', () => {
        s.visible = document.visibilityState === 'visible';
        if (s.visible) loop();
      });

      // Re-read the tints when the theme toggle flips data-theme, and when the
      // system scheme changes while no explicit theme is set.
      const themeChanged = () => {
        readTheme();
        loop();
      };
      new MutationObserver(themeChanged).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
      const schemeQuery = window.matchMedia('(prefers-color-scheme: dark)');
      if (schemeQuery.addEventListener) schemeQuery.addEventListener('change', themeChanged);

      if (reduceQuery.addEventListener) {
        reduceQuery.addEventListener('change', (e) => {
          s.reduce = e.matches;
          loop();
        });
      }

      // Fonts land after first paint and change the item widths, so measure
      // again once they have.
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(() => {
          s.ready = false;
          measure();
        });
      }
    };

    const start = () => {
      document.querySelectorAll('[data-lq]').forEach(initNav);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start);
    } else {
      start();
    }
  })();
</script>
